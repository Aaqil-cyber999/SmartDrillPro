/* SmartDrill Pro - industrial dark theme */
QWidget {
    background: #121821;
    color: #e6edf3;
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 13px;
}

#sidebar {
    background: #0c1118;
    border-right: 1px solid #243041;
}

#sidebar::item {
    padding: 12px 16px;
    border-left: 3px solid transparent;
}

#sidebar::item:selected {
    background: #1b2a3b;
    border-left: 3px solid #3fa7ff;
    color: #ffffff;
}

#pageTitle {
    font-size: 24px;
    font-weight: 600;
    color: #ffffff;
}

#sectionTitle {
    font-size: 15px;
    font-weight: 600;
    color: #8fc4ff;
    margin-top: 8px;
}

#subtitle {
    color: #9fb0c2;
}

#noticeText {
    color: #d6b45e;
}

#noticeCard {
    background: #2a2416;
    border: 1px solid #6b5624;
    border-radius: 6px;
    padding: 10px;
}

#stepCard {
    background: #18212c;
    border: 1px solid #26374a;
    border-radius: 5px;
    padding: 6px;
}

#stepBadge {
    color: #3fa7ff;
    font-weight: 700;
}

#statusChip {
    color: #d6b45e;
    font-weight: 600;
}

#footerNote {
    color: #607287;
}

QPushButton {
    background: #223145;
    border: 1px solid #38506c;
    border-radius: 5px;
    padding: 8px 14px;
}

QPushButton:hover {
    background: #2b4058;
}

QPushButton#primaryButton {
    background: #2563a8;
    border-color: #3fa7ff;
}

QPushButton#primaryButton:hover {
    background: #2f76c2;
}

QLineEdit, QTableWidget {
    background: #18212c;
    border: 1px solid #2b3b4f;
    border-radius: 4px;
    padding: 6px;
}

QTableWidget::item {
    padding: 5px;
}

QHeaderView::section {
    background: #1c2836;
    color: #9fb0c2;
    border: 0;
    padding: 7px;
}

QStatusBar {
    background: #0c1118;
    color: #9fb0c2;
}
